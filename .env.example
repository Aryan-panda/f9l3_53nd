# ==============================================================================
# f9l3_53nd — Environment Configuration Template
# WARNING: NEVER commit actual secrets, private keys, or passwords to Git.
# Copy this file to .env and run `make secrets` to generate local dev keys.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=false
APP_NAME=f9l3_53nd
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Security & Session Authentication
# Must be at least 32 cryptographically secure random bytes
SECRET_KEY=change_this_with_make_secrets_32_bytes_min_random_string_dev
SESSION_COOKIE_NAME=f9l3_session
SESSION_EXPIRY_SECONDS=86400
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# Cryptographic Master Key (Key Encryption Key - KEK)
# 256-bit AES master key represented as 64 hex characters
# WARNING: In production, provision this via KMS/HSM or secure secret injection.
MASTER_KEY_HEX=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=f9l3_user
POSTGRES_PASSWORD=f9l3_password_dev_only
POSTGRES_DB=f9l3_db
DATABASE_URL=postgresql+asyncpg://f9l3_user:f9l3_password_dev_only@localhost:5432/f9l3_db

# File Storage Paths & Limits
STORAGE_BASE_DIR=./storage
MAX_UPLOAD_SIZE_BYTES=52428800
CHUNK_SIZE_BYTES=1048576

# Network & CORS Settings
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# WireGuard Simulated Network Coordinates
WIREGUARD_BRANCH_A_ENDPOINT=10.50.0.1:51820
WIREGUARD_BRANCH_B_ENDPOINT=10.50.0.2:51820
WIREGUARD_ALLOWED_IPS=10.50.0.0/24
