# ==============================================================================
# WireGuard Configuration — Branch A (Endpoint 10.50.0.1)
# WARNING: NEVER commit actual private keys to Git.
# ==============================================================================

[Interface]
Address = 10.50.0.1/24
ListenPort = 51820
PrivateKey = <BRANCH_A_PRIVATE_KEY_GENERATE_WITH_WG_GENKEY>
SaveConfig = false

[Peer]
# Branch B Peer
PublicKey = <BRANCH_B_PUBLIC_KEY>
AllowedIPs = 10.50.0.2/32
Endpoint = branch-b.vpn.internal:51820
PersistentKeepalive = 25
